{
  "name": "moonwitness-monorepo",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @moonwitness/api dev",
    "dev:board": "pnpm --filter @moonwitness/board dev",
    "reset:superadmin-password": "pnpm --filter @moonwitness/api reset:superadmin-password",
    "jobs:worker": "pnpm --filter @moonwitness/api jobs:worker",
    "jobs:scheduler": "pnpm --filter @moonwitness/api jobs:scheduler",
    "jobs:outbox": "pnpm --filter @moonwitness/api jobs:outbox",
    "build": "pnpm -r build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && pnpm --filter @moonwitness/api exec vitest run --exclude tests/postgres.integration.test.ts && pnpm --filter @moonwitness/auth test && pnpm --filter @moonwitness/client test && pnpm --filter @moonwitness/jobs test && pnpm --filter @moonwitness/logger test && pnpm --filter @moonwitness/orm test && pnpm --filter @moonwitness/orm-base test",
    "test:integration": "node scripts/run-postgres-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build && pnpm --filter @moonwitness/board typecheck",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm docs:check",
    "release:check": "node scripts/check-release.mjs",
    "test:ci-gate": "node --test scripts/ci-gate.test.mjs",
    "ci:affected": "node scripts/select-affected.mjs",
    "test:affected": "node --test scripts/select-affected.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "typescript": "~5.7.3"
  }
}
