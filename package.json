{
  "name": "moonwitness-monorepo",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @moonwitness/api dev",
    "dev:board": "pnpm --filter @moonwitness/board dev",
    "reset:superadmin-password": "pnpm --filter @moonwitness/api reset:superadmin-password",
    "jobs:worker": "pnpm --filter @moonwitness/api jobs:worker",
    "jobs:scheduler": "pnpm --filter @moonwitness/api jobs:scheduler",
    "jobs:outbox": "pnpm --filter @moonwitness/api jobs:outbox",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "typescript": "~5.7.3"
  }
}
