{
  "name": "moonwitness-monorepo",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @moonwitness/api dev",
    "dev:board": "pnpm --filter @moonwitness/board dev",
    "reset:superadmin-password": "pnpm --filter @moonwitness/api reset:superadmin-password",
    "jobs:worker": "pnpm --filter @moonwitness/api jobs:worker",
    "jobs:scheduler": "pnpm --filter @moonwitness/api jobs:scheduler",
    "jobs:outbox": "pnpm --filter @moonwitness/api jobs:outbox",
    "build": "pnpm -r build",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && pnpm --filter @moonwitness/api exec vitest run --exclude tests/postgres.integration.test.ts --exclude tests/postgres.performance.integration.test.ts && pnpm --filter @moonwitness/auth test && pnpm --filter @moonwitness/client test && pnpm --filter @moonwitness/jobs test && pnpm --filter @moonwitness/logger test && pnpm --filter @moonwitness/orm test && pnpm --filter @moonwitness/orm-base test && pnpm test:assets && pnpm test:ui",
    "test:unit:ci": "node scripts/run-unit-tests.mjs",
    "test:integration": "node scripts/run-postgres-tests.mjs",
    "test:restore-drill": "node scripts/verify-application-restore.mjs",
    "assets:generate": "node packages/assets/scripts/generate.mjs && node packages/assets/scripts/generate-illustrations.mjs && node scripts/export-doc-assets.mjs",
    "assets:generate:illustrations": "node packages/assets/scripts/generate-illustrations.mjs && node scripts/export-doc-assets.mjs",
    "assets:export:docs": "node scripts/export-doc-assets.mjs",
    "assets:check:docs": "node scripts/export-doc-assets.mjs --check",
    "assets:render": "node packages/assets/scripts/render-social.mjs",
    "assets:validate": "node packages/assets/scripts/validate.mjs",
    "test:assets": "pnpm assets:validate && node --test packages/assets/tests/*.test.mjs scripts/export-doc-assets.test.mjs && pnpm assets:check:docs",
    "test:ui": "pnpm --filter @moonwitness/ui build && node --test packages/ui/tests/*.test.mjs && node packages/ui/scripts/verify-package.mjs",
    "test:ui-catalog": "pnpm --filter @moonwitness/ui-catalog build && pnpm --filter @moonwitness/ui-catalog test",
    "ui:budget": "node scripts/check-ui-catalog-budget.mjs",
    "test:ui-budget": "node --test apps/ui-catalog/tests/bundle-budget.test.mjs && pnpm --filter @moonwitness/ui-catalog build && pnpm ui:budget",
    "ui:visual:update": "pnpm --filter @moonwitness/ui-catalog build && pnpm --filter @moonwitness/ui-catalog exec playwright test --update-snapshots",
    "test:e2e": "node scripts/run-e2e.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build && pnpm --filter @moonwitness/board typecheck",
    "docs:check": "node scripts/check-docs.mjs",
    "architecture:generate": "pnpm --filter @moonwitness/orm build && pnpm --filter @moonwitness/orm-base build && node scripts/architecture/generate-diagrams.mjs",
    "architecture:check": "pnpm --filter @moonwitness/orm build && pnpm --filter @moonwitness/orm-base build && node scripts/architecture/generate-diagrams.mjs --check",
    "test:architecture": "node --test scripts/architecture/*.test.mjs",
    "audit:workspace": "node scripts/audit-workspace.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:architecture && pnpm architecture:check && pnpm docs:check",
    "release:check": "node scripts/check-release.mjs",
    "release:classify": "node scripts/classify-release-commits.mjs",
    "promotion:risk": "node scripts/check-promotion-risk.mjs",
    "promotion:approval-check": "node scripts/check-promotion-approval.mjs",
    "test:ci-gate": "node --test scripts/ci-gate.test.mjs",
    "test:artifact-safety": "node --test scripts/scan-test-reports.test.mjs",
    "test:coverage-policy": "node --test scripts/check-coverage.test.mjs",
    "test:flaky-policy": "node --test scripts/flaky-policy.test.mjs scripts/playwright-flake-reporter.test.mjs",
    "ci:affected": "node scripts/select-affected.mjs",
    "test:affected": "node --test scripts/select-affected.test.mjs",
    "test:release-classification": "node --test scripts/release-classification.test.mjs",
    "test:promotion-policy": "node --test scripts/git-range.test.mjs scripts/promotion-risk.test.mjs scripts/promotion-approval.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "typescript": "~5.7.3"
  }
}
