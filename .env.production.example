# Copy this file to .env.production, replace every placeholder, and keep it out of Git.
DATABASE_URL=postgresql://moonwitness:REPLACE_ME@postgres.example:5432/moonwitness
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
JWT_SECRET=
SUPERADMIN_PASSWORD=
METRICS_TOKEN=
WHATSAPP_INTERNAL_TOKEN=
# Generate a dedicated high-entropy secret of at least 32 bytes; keep it outside PostgreSQL backups.
WHATSAPP_SESSION_KEY=
# Set true only after confirming PostgreSQL storage and backups use encryption at rest.
WHATSAPP_DATABASE_ENCRYPTED_AT_REST=false
WHATSAPP_DATABASE_URL=
WHATSAPP_DATABASE_SCHEMA=whatsapp_session
API_PORT=3000
LOG_LEVEL=info
ATTACHMENT_STORAGE_DIR=/var/lib/moonwitness/attachments
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional production handler modules must be present inside the container image.
JOB_HANDLERS_MODULE=
OUTBOX_HANDLERS_MODULE=

# Optional private worker probes; assign distinct ports if all three processes share one host.
WORKER_HEALTH_HOST=127.0.0.1
JOBS_WORKER_HEALTH_PORT=0
JOBS_SCHEDULER_HEALTH_PORT=0
OUTBOX_WORKER_HEALTH_PORT=0
