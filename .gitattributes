# Source artifacts are content-addressed; Git must preserve their exact bytes.
corpus/reference/sha256/** -text

# Every text file checks out with LF on every platform. Prettier, the byte-exact
# docs reference check and the roadmap contract tests all compare LF content that
# is produced on Linux runners, so an autocrlf Windows checkout fails them.
* text=auto eol=lf

# Bash scripts must keep LF endings when checked out on Windows hosts.
scripts/*.sh text eol=lf

# Workflow YAML is asserted byte-for-byte by scripts/roadmap and scripts/*.test.mjs,
# and corpus manifests are hash-pinned by packages/local-ai retrieval; both compare
# LF content recorded from Linux CI, so a CRLF checkout breaks them.
.github/**/*.yml text eol=lf
corpus/manifests/** text eol=lf

# Design assets are hashed byte-for-byte into docs/assets/moonwitness/asset-map.json,
# so a CRLF checkout on Windows would commit hashes that Linux CI cannot reproduce.
packages/assets/**/*.svg text eol=lf
packages/assets/**/*.json text eol=lf
packages/assets/**/*.css text eol=lf
packages/assets/**/*.txt text eol=lf
packages/assets/**/*.md text eol=lf
packages/assets/**/*.mjs text eol=lf
docs/assets/**/*.svg text eol=lf
docs/assets/**/*.json text eol=lf
docs/assets/**/*.css text eol=lf
packages/ui/src/styles/tokens.css text eol=lf
packages/assets/**/*.png -text
packages/assets/**/*.woff2 -text
packages/assets/**/*.wav -text
docs/assets/**/*.png -text
docs/assets/**/*.wav -text

# Generated references and README are compared byte-for-byte by docs:check.
README.md text eol=lf
docs/guide/reference/** text eol=lf

# Architecture diagrams are generated and compared byte-for-byte.
docs/architecture/**/*.mmd text eol=lf
docs/architecture/**/*.svg text eol=lf
docs/architecture/**/*.json text eol=lf

# Typed React icons are regenerated by the UI build.
packages/ui/src/icons/** text eol=lf
