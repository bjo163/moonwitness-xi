{
  "name": "@moonwitness/ui",
  "version": "1.0.0-rc.1",
  "description": "Typed React icons and shared MoonWitness design tokens",
  "type": "module",
  "license": "ISC",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "TOKENS.md"
  ],
  "exports": {
    "./components.css": "./src/styles/components.css",
    "./components/button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js"
    },
    "./components/input": {
      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js"
    },
    "./components/checkbox": {
      "types": "./dist/components/checkbox.d.ts",
      "import": "./dist/components/checkbox.js"
    },
    "./components/badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js"
    },
    "./components/avatar": {
      "types": "./dist/components/avatar.d.ts",
      "import": "./dist/components/avatar.js"
    },
    "./components/select-field": {
      "types": "./dist/components/select-field.d.ts",
      "import": "./dist/components/select-field.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "build": "node scripts/generate-icons.mjs && tsc",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "radix-ui": ">=1.6.7",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "radix-ui": "^1.6.7",
    "radix-ui": "^1.6.7",
    "react-dom": "^19.3.0"
  }
}
